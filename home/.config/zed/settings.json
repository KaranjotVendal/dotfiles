// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "existing_window",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "agent_servers": {
    "pi-acp": {
      "type": "registry"
    }
  },
  "edit_predictions": {
    "provider": "zed",
    "mode": "eager",
  },

  "debugger": {
    "dock": "bottom"
  },
  "terminal": {
    "dock": "bottom"
  },
  "icon_theme": "Colored Zed Icons Theme Dark",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Modest Dark"
  },
  "vim_mode": false,
  "base_keymap": "VSCode",
  // Formatting: global default. Python overrides this below.
  "formatter": "language_server",
  "format_on_save": "off",
  "multi_cursor_modifier": "alt",
  "lsp": {
    "basedpyright": {
      "settings": {
        "basedpyright.analysis": {
          "diagnosticMode": "workspace"
        }
      }
    },
    "ruff": {
      // Use project-local ruff for LSP (diagnostics, code actions, hover)
      // Ruff auto-discovers pyproject.toml / ruff.toml in the project root.
      "binary": {
        "path": "uv",
        "arguments": ["run", "ruff", "server"]
      },
      "initialization_options": {
        "settings": {
          // Remove project-specific overrides here.
          // Ruff reads pyproject.toml automatically — that's the source of truth.
          "logLevel": "warn"
        }
      }
    }
  },
  "languages": {
    "Python": {
      "language_servers": [
        "ty",
        "ruff"
      ],
      // Enable format-on-save specifically for Python
      "format_on_save": "on",
      // Use the LSP's formatting capability (ruff server handles this)
      "formatter": "language_server",
      "code_actions_on_format": {
        "source.organizeImports.ruff": true,
        "source.fixAll.ruff": true
      }
    }
  }
}
